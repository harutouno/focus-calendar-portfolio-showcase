# Focus Calendar — Portfolio Edition
#
# 値は入っていません。ローカルで npx supabase start を実行すると
# API URL と anon key が表示されるので、それをここへ入れてください。
# このファイル自体に実際の値を書いてコミットしないこと。

# 必須 --------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 任意（Google / Apple サインインを試す場合のみ）----------------------
# 未設定ならサインインボタン自体が表示されず、メール認証で全機能を触れます。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# AI は常に Demo（端末内生成）です。外部 LLM の設定は不要です。

# 任意（お問い合わせ画面 /contact のmailto送信先）--------------------
# 未設定なら画面自体はメニューから隠れ、直接遷移した場合も安全に案内文を出す。
EXPO_PUBLIC_SUPPORT_EMAIL=
